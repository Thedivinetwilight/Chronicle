# ---------------------------------------------------------------------------
# Chronicle — ignore list
# Node + Vite + TypeScript. Nothing here is optional: generated artefacts and
# secrets must never enter the repository.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
dev-dist/
build/
*.local

# Generated app icons (recreated by `npm run icons`)
public/icons/

# Test & tooling caches
coverage/
.vite/
vitest.config.ts.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo

# Environment & secrets — an API key must never be committed (§17)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors & operating systems
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
